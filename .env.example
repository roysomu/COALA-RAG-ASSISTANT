DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

GEMINI_API_KEY=
OPENAI_API_KEY=

EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

SIMPLE_CHAT_MODEL=gemini/gemini-2.5-flash-lite
COMPLEX_CHAT_MODEL=openai/gpt-4.1-mini
FALLBACK_CHAT_MODEL=gemini/gemini-2.5-flash

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=local-coala-rag-assistant
LANGSMITH_ENDPOINT=

DEFAULT_USER_ID=local-user
DEFAULT_TOP_K=5
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

CHECKPOINT_DURABILITY=exit
RECENT_MESSAGES_TO_KEEP=12
MAX_MESSAGES_PER_THREAD=50
CHECKPOINT_RETENTION_DAYS=30
MAX_RETAINED_THREADS=20
AUTO_PRUNE_CHECKPOINTS=false

DATABASE_WARNING_MB=350
